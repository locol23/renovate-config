{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)",
    ":semanticCommits",
    ":rebaseStalePrs",
    "helpers:disableTypesNodeMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["after 9pm", "before 9am"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Automerge stable minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Allow pinDigest updates immediately so frequently releasing Actions are not left unpinned",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Label GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "addLabels": ["CI"]
    },
    {
      "description": "Pin npm app dependency versions and label updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "addLabels": ["dependencies"],
      "rangeStrategy": "pin"
    }
  ]
}
